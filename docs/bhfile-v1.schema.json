{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://behav.app/schemas/bhfile-v1.json",
  "title": "BHFile v1 Specification",
  "description": "Authoritative JSON Schema for Behav BHFile v1 data interchange format",
  "type": "object",
  "required": ["format", "version", "habits", "days", "summary"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "const": "bhfile",
      "description": "Canonical format identifier"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Format version number (1 for BHFile v1)"
    },
    "habits": {
      "type": "array",
      "description": "List of user-defined habits tracked in this file",
      "items": {
        "type": "object",
        "required": ["id", "name", "unit"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable unique identifier for the habit (e.g. H1)"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable habit name"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "Measurement unit (e.g. cigarettes, occurrences, ml)"
          }
        }
      }
    },
    "days": {
      "type": "array",
      "description": "Chronologically ordered array of calendar day records",
      "items": {
        "type": "object",
        "required": ["date", "habits"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Calendar date in YYYY-MM-DD format"
          },
          "habits": {
            "type": "object",
            "description": "Mapping from every habit ID to its numeric quantity for this date",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Calculated summary of the included day records",
      "required": ["totalDays", "greenDays", "maxStreak", "habits"],
      "additionalProperties": false,
      "properties": {
        "totalDays": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of day entries in days array"
        },
        "greenDays": {
          "type": "integer",
          "minimum": 0,
          "description": "Total count of recorded days where every habit quantity equals zero"
        },
        "maxStreak": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of consecutive calendar days that are green"
        },
        "habits": {
          "type": "object",
          "description": "Mapping from each habit ID to its total aggregate quantity across all days",
          "additionalProperties": {
            "type": "object",
            "required": ["total"],
            "additionalProperties": false,
            "properties": {
              "total": {
                "type": "number",
                "minimum": 0,
                "description": "Total sum of quantities for this habit across all days"
              }
            }
          }
        }
      }
    }
  }
}

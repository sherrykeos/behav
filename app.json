{
  "expo": {
    "name": "Behav",
    "slug": "behav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appLogo.png",
    "scheme": "behav",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/appLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#101412"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.behav.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#101412",
        "foregroundImage": "./assets/appLogo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/appLogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#101412",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#101412"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101412",
          "image": "./assets/appLogo.png",
          "imageWidth": 120,
          "dark": {
            "image": "./assets/appLogo.png",
            "backgroundColor": "#101412"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b555d8a8-659e-4aea-ba89-5d33d17c3381"
      }
    }
  }
}

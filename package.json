{
  "name": "behav-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade behavior tracking application: Measure. Understand. Change.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start:mobile": "npm --workspace=@behav/mobile run start",
    "start:tunnel": "npm --workspace=@behav/mobile run start:tunnel",
    "start:api": "npm --workspace=@behav/api start",
    "test": "npm run test --workspaces --if-present",
    "test:domain": "npm --workspace=@behav/domain test",
    "test:api": "npm --workspace=@behav/api test",
    "test:mobile": "npm --workspace=@behav/mobile test",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

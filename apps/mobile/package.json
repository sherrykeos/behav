{
  "name": "@behav/mobile",
  "version": "1.0.0",
  "description": "Production-grade Behav mobile application built with Expo and React Native",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --host lan",
    "start:tunnel": "expo start --tunnel",
    "start:local": "expo start --host localhost",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "build": "tsc -b"
  },
  "dependencies": {
    "@behav/domain": "file:../../packages/domain",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.8",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.16",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "~6.0.3"
  }
}

{
  "expo": {
    "name": "Behav",
    "slug": "behav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "behav",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0F0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.behav.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0D"
      },
      "package": "com.behav.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
